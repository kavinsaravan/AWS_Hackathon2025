            "isHidden": false
          },
          {
            "name": "Neighborhood",
            "dataType": "string",
            "sourceColumn": "Neighborhood",
            "summarizeBy": "none",
            "lineageTag": "2db012fb-5156-58e7-8713-e64f2a1db63f",
            "isHidden": false
          },
          {
            "name": "District",
            "dataType": "string",
            "sourceColumn": "District",
            "summarizeBy": "none",
            "lineageTag": "e512e44b-fc60-5a39-ae05-d38857002fa4",
            "isHidden": false
          },
          {
            "name": "EventDate",
            "dataType": "dateTime",
            "sourceColumn": "EventDate",
            "summarizeBy": "none",
            "lineageTag": "23c0f3c9-fbf3-573f-9239-fffd9f8f8f46",
            "isHidden": false,
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "LocalTimestamp",
            "dataType": "dateTime",
            "sourceColumn": "LocalTimestamp",
            "summarizeBy": "none",
            "lineageTag": "798ca3e7-2186-50ea-a4d4-6ef1d097933b",
            "isHidden": false,
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Hour",
            "dataType": "int64",
            "sourceColumn": "Hour",
            "summarizeBy": "none",
            "lineageTag": "684d8688-9db9-51bb-9a6c-6eb483d6d0b2",
            "isHidden": false
          },
          {
            "name": "Weekday",
            "dataType": "string",
            "sourceColumn": "Weekday",
            "summarizeBy": "none",
            "lineageTag": "aa570dbb-933c-5ce1-85bd-d06099eaf244",
            "isHidden": false,
            "sortByColumn": "WeekdayNumber"
          },
          {
            "name": "WeekdayNumber",
            "dataType": "int64",
            "sourceColumn": "WeekdayNumber",
            "summarizeBy": "none",
            "lineageTag": "940c4ba8-904e-5d1c-ac0c-dcfb485bc2d9",
            "isHidden": true
          },
          {
            "name": "Latitude",
            "dataType": "double",
            "sourceColumn": "Latitude",
            "summarizeBy": "none",
            "lineageTag": "9f474def-59bf-50c6-b220-b659cd7ac0ee",
            "isHidden": false,
            "dataCategory": "Latitude"
          },
          {
            "name": "Longitude",
            "dataType": "double",
            "sourceColumn": "Longitude",
            "summarizeBy": "none",
            "lineageTag": "ee3b8bab-a0dd-5ae6-afef-2c7c5ca952c0",
            "isHidden": false,
            "dataCategory": "Longitude"
          },
          {
            "name": "IsGeocoded",
            "dataType": "int64",
            "sourceColumn": "IsGeocoded",
            "summarizeBy": "none",
            "lineageTag": "693e7214-f47a-5129-ac2a-6eb84768c310",
            "isHidden": false
          },
          {
            "name": "MissingTime",
            "dataType": "int64",
            "sourceColumn": "MissingTime",
            "summarizeBy": "none",
            "lineageTag": "732f4474-9ca7-5ceb-9df7-750817e66811",
            "isHidden": false
          },
          {
            "name": "Severity",
            "dataType": "string",
            "sourceColumn": "Severity",
            "summarizeBy": "none",
            "lineageTag": "7559ba12-cbf4-5b9c-bc25-39ab5549f6e8",
            "isHidden": false
          },
          {
            "name": "RuleWeight",
            "dataType": "int64",
            "sourceColumn": "RuleWeight",
            "summarizeBy": "none",
            "lineageTag": "7f17dca6-28f0-59f8-a43b-c6d59fb7924d",
            "isHidden": false
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none",
            "lineageTag": "328961a6-7bf5-5be8-9793-f1f418e0317b",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "Incidents",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Content = Web.Contents(DataFolder, [RelativePath=\"incidents.csv\"]),",
                "    Source = Csv.Document(Content, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    EmptyAsNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(EmptyAsNull, {{\"RecordKey\", type text}, {\"ExternalId\", type text}, {\"Source\", type text}, {\"Category\", type text}, {\"Neighborhood\", type text}, {\"District\", type text}, {\"EventDate\", type datetime}, {\"LocalTimestamp\", type datetime}, {\"Hour\", Int64.Type}, {\"Weekday\", type text}, {\"WeekdayNumber\", Int64.Type}, {\"Latitude\", type number}, {\"Longitude\", type number}, {\"IsGeocoded\", Int64.Type}, {\"MissingTime\", Int64.Type}, {\"Severity\", type text}, {\"RuleWeight\", Int64.Type}, {\"Status\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Records",
            "expression": "COUNTROWS(Incidents)",
            "description": "All exported rows after deduplication; not unique cross-source events.",
            "lineageTag": "6ea19f53-e316-5fc6-955a-a92e9393bb17",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Police Incident Records",
            "expression": "CALCULATE([Total Records], KEEPFILTERS(Incidents[Source] = \"Police incidents\"))",
            "description": "Police report rows; a single incident can contain multiple offense rows.",
            "lineageTag": "d7a164a1-85b8-57e3-956a-17428ce72da0",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Unique Police Incidents",
            "expression": "CALCULATE(DISTINCTCOUNT(Incidents[ExternalId]), KEEPFILTERS(Incidents[Source] = \"Police incidents\"))",
            "description": "Distinct police incident IDs within the current report filters.",
            "lineageTag": "48879148-a00e-5660-a7cf-cfe86ffbb1ea",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Police Call Records",
            "expression": "CALCULATE([Total Records], KEEPFILTERS(Incidents[Source] = \"Police calls\"))",
            "description": "Dispatch record rows in a 72-hour window.",
            "lineageTag": "f1e32485-895f-53d3-a92f-24884ee5e672",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Open 311 Records",
            "expression": "CALCULATE([Total Records], KEEPFILTERS(Incidents[Source] = \"Open 311 reports\"))",
            "description": "Open reports requested in the past 30 days.",
            "lineageTag": "f0cf1714-d8d8-5e5f-9380-9c2675855f92",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Geocoded Records",
            "expression": "CALCULATE([Total Records], Incidents[IsGeocoded] = 1)",
            "description": "Records with coordinates within the SF bounding box.",
            "lineageTag": "e5f1c8a6-e5d1-5105-9ef8-2cdc894cef0e",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Geocoded Share",
            "expression": "DIVIDE([Geocoded Records], [Total Records], 0)",
            "description": "Coverage among exported records, including missing/outside coordinates.",
            "lineageTag": "36400daf-078d-5be6-bbe4-289f9e0ace86",
            "displayFolder": "Dashboard measures",
            "formatString": "0.0%"
          },
          {
            "name": "High Rule Severity Records",
            "expression": "CALCULATE([Total Records], Incidents[Severity] = \"High (rule)\")",
            "description": "Rule-based grouping; not a trained classifier.",
            "lineageTag": "d3906eb9-7115-5399-b6e5-5b2712028a0f",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Crime Mean Latitude",
            "expression": "CALCULATE(AVERAGE(Incidents[Latitude]), Incidents[Source] = \"Police incidents\", Incidents[IsGeocoded] = 1)",
            "description": "Neighborhood centroid of geocoded police report rows.",
            "lineageTag": "028795aa-e5ef-5d7f-91bd-195775b0a9ec",
            "displayFolder": "Dashboard measures",
            "formatString": "0.00000"
          },
          {
            "name": "Crime Mean Longitude",
            "expression": "CALCULATE(AVERAGE(Incidents[Longitude]), Incidents[Source] = \"Police incidents\", Incidents[IsGeocoded] = 1)",
            "description": "Neighborhood centroid of geocoded police report rows.",
            "lineageTag": "516ffe47-096d-5dd9-b0a9-8fcf19145461",
            "displayFolder": "Dashboard measures",
            "formatString": "0.00000"
          },
          {
            "name": "Sampled Locations",
            "expression": "COUNTROWS(RiskLocations)",
            "description": "Seeded sampled locations, not walking routes.",
            "lineageTag": "3fe5ed5b-4ea7-5bef-ace9-b01a2ed45e48",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Flagged Heuristic Locations",
            "expression": "CALCULATE([Sampled Locations], RiskLocations[HeuristicFlag] = 1)",
            "description": "Proxy labels from documented weighted incident counts.",
            "lineageTag": "919da694-d051-5703-b1fa-2e36188614ab",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Heuristic Flagged Share",
            "expression": "DIVIDE([Flagged Heuristic Locations], [Sampled Locations], 0)",
            "description": "Not an observed unsafe-area prevalence or probability of danger.",
            "lineageTag": "d789a86b-0a2e-57f0-ba6b-a7db429f174c",
            "displayFolder": "Dashboard measures",
            "formatString": "0.0%"
          },
          {
            "name": "Mean Proxy Risk",
            "expression": "AVERAGE(RiskLocations[ProxyRiskScore])",
            "description": "Weighted incident-count proxy, not the route scoring index.",
            "lineageTag": "0325d30a-4f26-5948-bceb-904915b036a0",
            "displayFolder": "Dashboard measures",
            "formatString": "0.0"
          },
          {
            "name": "Raw Source Rows",
            "expression": "SUM(SourceQuality[FetchedRows])",
            "description": "Includes duplicate source rows before deduplication.",
            "lineageTag": "7915787a-8f72-5e37-89fb-ea67a9d4e748",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Duplicates Removed",
            "expression": "SUM(SourceQuality[DuplicatesRemoved])",
            "description": "Duplicate rows within each source, not cross-source deduplication.",
            "lineageTag": "3da5d08a-63fc-5ad5-bd65-1282b1743d6e",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Missing Coordinate Rows",
            "expression": "SUM(SourceQuality[MissingCoordinates])",
            "description": "Retained for quality reporting; not shown on maps.",
            "lineageTag": "9a1954cb-89d3-5772-aee6-abd9d8537761",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Missing Time Rows",
            "expression": "SUM(SourceQuality[MissingTime])",
            "description": "Malformed/missing source event timestamps.",
            "lineageTag": "c9cd9d85-e95c-5d32-805b-b0a6f3726ab9",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Unknown Neighborhood Rows",
            "expression": "SUM(SourceQuality[UnknownNeighborhood])",
            "description": "Source did not supply analysis neighborhood.",
            "lineageTag": "4f9e6b09-b29c-55d8-9fb8-750c7f24e59f",
            "displayFolder": "Dashboard measures",
            "formatString": "#,0"
          },
          {
            "name": "Last Refreshed UTC",
            "expression": "FORMAT(MAX(RefreshMetadata[RefreshedUTC]), \"yyyy-MM-dd HH:mm\") & \" UTC\"",
            "description": "Timestamp of the Python export, not a live stream.",
            "lineageTag": "14725193-8394-5118-becd-7d9bbe4485d2",
            "displayFolder": "Dashboard measures"
          }
        ]
      },
